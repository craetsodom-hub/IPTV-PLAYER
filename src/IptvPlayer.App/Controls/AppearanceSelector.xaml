<UserControl x:Class="IptvPlayer.App.Controls.AppearanceSelector"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IptvPlayer.App.Localization"
             xmlns:themes="clr-namespace:IptvPlayer.App.Themes"
             Focusable="True"
             PreviewKeyDown="AppearanceSelector_OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Tag" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Shape.CornerRadius.7}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.1A2E48}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SelectionBackground}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="SettingsButton"
                Style="{StaticResource SettingsButtonStyle}"
                ToolTip="{loc:Loc Appearance}"
                Click="SettingsButton_OnClick">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       FontSize="15"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       Text="&#xE713;" />
        </Button>

        <Popup x:Name="AppearancePopup"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Custom"
               CustomPopupPlacementCallback="AppearancePopup_OnCustomPlacement"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               Opened="AppearancePopup_OnOpened"
               Closed="AppearancePopup_OnClosed">
            <Grid Width="274">
                <Grid.Effect>
                    <DropShadowEffect Color="{DynamicResource Theme.Color.000000}"
                                      BlurRadius="14"
                                      ShadowDepth="4"
                                      Opacity="{DynamicResource Design.Opacity.0_48}" />
                </Grid.Effect>

                <Border Margin="0,9,0,0"
                        Padding="14"
                        Background="{DynamicResource Brush.CardBackground}"
                        BorderBrush="{DynamicResource Brush.InputBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Shape.CornerRadius.10}">

                <StackPanel>
                    <TextBlock x:Name="PopupTitle"
                               Focusable="True"
                               Margin="0,0,0,13"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{loc:Loc Appearance}" />

                    <TextBlock Margin="2,0,0,5"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="{loc:Loc Design}" />
                    <ComboBox Height="38"
                              Margin="0,0,0,13"
                              Padding="10,0"
                              AutomationProperties.Name="{loc:Loc Design}"
                              ItemsSource="{Binding Designs, Source={x:Static themes:DesignManager.Current}}"
                              SelectedItem="{Binding CurrentDesign, Source={x:Static themes:DesignManager.Current}, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type themes:DesignOption}">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Margin="2,0,0,5"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="{loc:Loc Color}" />
                    <ComboBox Height="38"
                              Padding="10,0"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{loc:Loc ColorTheme}"
                              ItemsSource="{Binding Themes, Source={x:Static themes:ThemeManager.Current}}"
                              SelectedItem="{Binding CurrentTheme, Source={x:Static themes:ThemeManager.Current}, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type themes:ThemeOption}">
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,9,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Border Width="8"
                                                Height="18"
                                                Background="{Binding SurfaceBrush}"
                                                CornerRadius="{DynamicResource Shape.CornerRadius.SwatchLeft}" />
                                        <Border Width="8"
                                                Height="18"
                                                Background="{Binding PrimaryBrush}" />
                                        <Border Width="8"
                                                Height="18"
                                                Background="{Binding SecondaryBrush}" />
                                        <Border Width="8"
                                                Height="18"
                                                Background="{Binding TertiaryBrush}"
                                                CornerRadius="{DynamicResource Shape.CornerRadius.SwatchRight}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>
                </Border>

                <Canvas Width="20"
                        Height="11"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Panel.ZIndex="2">
                    <Polygon Points="0,10 10,0 20,10 20,11 0,11"
                             Fill="{DynamicResource Brush.CardBackground}" />
                    <Path Data="M0,10 L10,0 L20,10"
                          Stroke="{DynamicResource Brush.InputBorder}"
                          StrokeThickness="1"
                          StrokeStartLineCap="Square"
                          StrokeEndLineCap="Square"
                          StrokeLineJoin="Miter" />
                </Canvas>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
