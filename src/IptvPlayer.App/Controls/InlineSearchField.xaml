<UserControl x:Class="IptvPlayer.App.Controls.InlineSearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SearchRoot"
             Height="34"
             MinHeight="34"
             Focusable="False"
             IsVisibleChanged="InlineSearchField_OnIsVisibleChanged">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="3" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Viewbox Width="14"
                     Height="14"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
                <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                      Stroke="{DynamicResource Brush.TextSecondary}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Viewbox>

            <Grid Grid.Column="1"
                  Margin="0,0,5,0">
                <TextBox x:Name="SearchTextBox"
                         Text="{Binding Text, ElementName=SearchRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0"
                         Padding="0"
                         MinHeight="0"
                         Height="31"
                         Background="Transparent"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Brush.AccentHover}"
                         FontSize="13"
                         FontWeight="Normal"
                         VerticalContentAlignment="Center"
                         SelectionBrush="{DynamicResource Brush.SelectionBackground}"
                         ToolTip="{Binding Placeholder, ElementName=SearchRoot}" />
                <TextBlock Text="{Binding Placeholder, ElementName=SearchRoot}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchRoot}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchRoot}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="2"
                    Width="22"
                    Height="22"
                    MinHeight="22"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding CloseCommand, ElementName=SearchRoot}"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="{Binding ClearToolTip, ElementName=SearchRoot}"
                    AutomationProperties.Name="{Binding ClearToolTip, ElementName=SearchRoot}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearHover"
                                Background="Transparent"
                                CornerRadius="3">
                            <Viewbox Width="10"
                                     Height="10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="M1,1 L9,9 M9,1 L1,9"
                                      Stroke="{DynamicResource Brush.TextSecondary}"
                                      StrokeThickness="1.45"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearHover" Property="Background" Value="{DynamicResource Theme.Brush.12FFFFFF}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClearHover" Property="Background" Value="{DynamicResource Theme.Brush.1CFFFFFF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              VerticalAlignment="Bottom"
              IsHitTestVisible="False">
            <Border Height="3"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Brush.Accent}"
                    Opacity="0.16" />
            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Brush.AccentHover}"
                    SnapsToDevicePixels="True" />
        </Grid>
    </Grid>
</UserControl>
