<UserControl x:Class="IptvPlayer.App.Controls.PlayerControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IptvPlayer.App.Localization"
             x:Name="ControlRoot"
             Height="82"
             MinWidth="430"
             Focusable="False"
             UseLayoutRounding="True"
             MouseEnter="PlayerControlBar_OnMouseActivity"
             MouseMove="PlayerControlBar_OnMouseActivity"
             PreviewMouseDown="PlayerControlBar_OnPointerInteraction"
             PreviewMouseUp="PlayerControlBar_OnPointerInteraction">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PlayerOverlayIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.FFFFFFFF}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.ShowDuration" Value="5000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Shape.CornerRadius.8}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordingIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PlayerOverlayIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#42FF3030" />
                    <Setter Property="Foreground" Value="#FFFF4E4E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlayerVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="112" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
            <Setter Property="Background" Value="#4DFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent"
                              ClipToBounds="False"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <!--
                                The Track must receive the slider's full vertical arrange slot.
                                Giving Track the rail's 3-DIP height clips a larger Thumb at its
                                arrange boundary on some DPI scales. The rail is drawn inside the
                                full-height repeat buttons instead.
                            -->
                            <Track x:Name="PART_Track"
                                   Height="36"
                                   VerticalAlignment="Center"
                                   Orientation="Horizontal"
                                   ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{TemplateBinding Foreground}"
                                                  BorderThickness="0"
                                                  IsTabStop="False"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="36" Background="Transparent" ClipToBounds="False">
                                                    <Border Height="3"
                                                            VerticalAlignment="Center"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{DynamicResource Shape.CornerRadius.1_5}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{TemplateBinding Background}"
                                                  BorderThickness="0"
                                                  IsTabStop="False"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="36" Background="Transparent" ClipToBounds="False">
                                                    <Border Height="3"
                                                            VerticalAlignment="Center"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{DynamicResource Shape.CornerRadius.1_5}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="36"
                                           Background="Transparent"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="14"
                                                      Height="36"
                                                      Background="Transparent"
                                                      ClipToBounds="False"
                                                      SnapsToDevicePixels="True"
                                                      UseLayoutRounding="True">
                                                    <Ellipse Width="12"
                                                             Height="12"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource Theme.Brush.FFFFFFFF}"
                                                             Stroke="{DynamicResource Brush.AccentHover}"
                                                             StrokeThickness="1.25" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerTimelineSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent"
                              ClipToBounds="False"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Track x:Name="PART_Track"
                                   Height="24"
                                   VerticalAlignment="Center"
                                   Orientation="Horizontal"
                                   ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{TemplateBinding Foreground}"
                                                  BorderThickness="0"
                                                  IsTabStop="False"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="24"
                                                      Background="Transparent"
                                                      ClipToBounds="False">
                                                    <Border Height="3"
                                                            VerticalAlignment="Center"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{DynamicResource Shape.CornerRadius.1_5}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{TemplateBinding Background}"
                                                  BorderThickness="0"
                                                  IsTabStop="False"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="24"
                                                      Background="Transparent"
                                                      ClipToBounds="False">
                                                    <Border Height="3"
                                                            VerticalAlignment="Center"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{DynamicResource Shape.CornerRadius.1_5}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="24"
                                           Background="Transparent"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="14"
                                                      Height="24"
                                                      Background="Transparent"
                                                      ClipToBounds="False"
                                                      SnapsToDevicePixels="True">
                                                    <Ellipse Width="10"
                                                             Height="10"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource Theme.Brush.FFFFFFFF}"
                                                             Stroke="{DynamicResource Brush.AccentHover}"
                                                             StrokeThickness="1.25" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#18000000" Offset="0.24" />
                    <GradientStop Color="#76000000" Offset="0.66" />
                    <GradientStop Color="#D6000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="16,0,16,12"
              VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition x:Name="TimelineControlsGapRow" Height="0" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="24"
                  ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Margin="0,0,8,0"
                  ClipToBounds="False">
                <Slider Style="{StaticResource PlayerTimelineSliderStyle}"
                        Maximum="{Binding PlaybackDurationSeconds}"
                        Value="{Binding PlaybackPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsPlaybackSeekAvailable}"
                        Visibility="{Binding IsOnDemandPlaybackActive, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="{Binding PlaybackPositionText}"
                        AutomationProperties.Name="{loc:Loc PlaybackPosition}"
                        PreviewMouseLeftButtonDown="InteractiveSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseMove="InteractiveSlider_OnPreviewMouseMove"
                        PreviewMouseLeftButtonUp="InteractiveSlider_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="InteractiveSlider_OnLostMouseCapture" />

                <Slider Style="{StaticResource PlayerTimelineSliderStyle}"
                        Maximum="100"
                        Value="{Binding LivePlaybackProgressPercent, Mode=OneWay}"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsLivePlaybackActive, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="{Binding LivePlaybackElapsedText}"
                        AutomationProperties.Name="{loc:Loc LiveProgress}" />
            </Grid>

            <Grid Grid.Column="1"
                  MinWidth="38"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
                <TextBlock Text="{Binding LivePlaybackElapsedText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Brush.FFFFFFFF}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Visibility="{Binding IsLivePlaybackActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding PlaybackPositionText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Brush.FFFFFFFF}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Visibility="{Binding IsOnDemandPlaybackActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>

            <Grid Grid.Row="2"
                  Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource PlayerOverlayIconButtonStyle}"
                        Command="{Binding TogglePlayPauseCommand}"
                        ToolTip="{Binding PlayPauseToolTip}"
                        AutomationProperties.Name="{Binding PlayPauseToolTip}">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Path Data="{Binding PlayPauseIconGeometry}"
                              Width="18"
                              Height="18"
                              Stretch="None"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource PlayerOverlayIconButtonStyle}"
                        Command="{Binding StopCommand}"
                        ToolTip="{loc:Loc Stop}"
                        AutomationProperties.Name="{loc:Loc Stop}">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Rectangle Width="12"
                                   Height="12"
                                   RadiusX="1.25"
                                   RadiusY="1.25"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.6" />
                    </Grid>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource PlayerOverlayIconButtonStyle}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip="{Binding VolumeToolTip}"
                        AutomationProperties.Name="{Binding VolumeToolTip}">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Path Data="{Binding VolumeIconGeometry}"
                              Width="18"
                              Height="18"
                              Stretch="None"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </Button>

                <Slider Grid.Column="3"
                        Style="{StaticResource PlayerVolumeSliderStyle}"
                        Margin="4,0,10,0"
                        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding Volume}"
                        AutomationProperties.Name="{loc:Loc Volume}"
                        PreviewMouseLeftButtonDown="InteractiveSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseMove="InteractiveSlider_OnPreviewMouseMove"
                        PreviewMouseLeftButtonUp="InteractiveSlider_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="InteractiveSlider_OnLostMouseCapture" />

                <StackPanel Grid.Column="4"
                            Margin="1,0,10,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.AccentHover}" />
                        <TextBlock Text="{loc:Loc Live}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.AccentHover}"
                                   FontSize="9"
                                   FontWeight="Bold" />
                </StackPanel>

                <Button Grid.Column="6"
                        Style="{StaticResource PlayerOverlayIconButtonStyle}"
                        ToolTip="{loc:Loc Screenshot}"
                        AutomationProperties.Name="{loc:Loc Screenshot}"
                        Click="ScreenshotButton_OnClick">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Path Data="M3,5.5 L5.5,5.5 L7,3.75 L11,3.75 L12.5,5.5 L15,5.5 C15.7,5.5 16,5.8 16,6.5 L16,14 C16,14.7 15.7,15 15,15 L3,15 C2.3,15 2,14.7 2,14 L2,6.5 C2,5.8 2.3,5.5 3,5.5 Z M9,7.25 A2.75,2.75 0 1 0 9,12.75 A2.75,2.75 0 1 0 9,7.25"
                              Width="18"
                              Height="18"
                              Stretch="None"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </Button>

                <Button Grid.Column="8"
                        Style="{StaticResource RecordingIconButtonStyle}"
                        Tag="{Binding IsRecording, ElementName=ControlRoot}"
                        ToolTip="{Binding RecordingToolTip, ElementName=ControlRoot}"
                        AutomationProperties.Name="{Binding RecordingToolTip, ElementName=ControlRoot}"
                        Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="RecordButton_OnClick">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Ellipse Width="15"
                                 Height="15"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="1.6" />
                        <Ellipse Width="5.5"
                                 Height="5.5"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>

                <Button Grid.Column="7"
                        Style="{StaticResource PlayerOverlayIconButtonStyle}"
                        ToolTip="{Binding DisplayModeToolTip, ElementName=ControlRoot}"
                        AutomationProperties.Name="{Binding DisplayModeToolTip, ElementName=ControlRoot}"
                        Click="DisplayModeButton_OnClick">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Path Width="18"
                              Height="18"
                              Stretch="None"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M2,4 L16,4 L16,14 L2,14 Z M6,7 L8,7 L8,9 M12,11 L10,11 L10,9" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStretchDisplayMode, ElementName=ControlRoot}" Value="True">
                                            <Setter Property="Data" Value="M2,4 L16,4 L16,14 L2,14 Z M8,9 L5,6 M5,6 L7.5,6 M5,6 L5,8.5 M10,9 L13,12 M13,12 L10.5,12 M13,12 L13,9.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <Button Grid.Column="9"
                        Style="{StaticResource PlayerOverlayIconButtonStyle}"
                        ToolTip="{Binding FullscreenToolTip, ElementName=ControlRoot}"
                        AutomationProperties.Name="{Binding FullscreenToolTip, ElementName=ControlRoot}"
                        Click="FullscreenButton_OnClick">
                    <Grid Width="18" Height="18" ClipToBounds="False">
                        <Path Width="18"
                              Height="18"
                              Stretch="None"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M2,7 L2,2 L7,2 M11,2 L16,2 L16,7 M16,11 L16,16 L11,16 M7,16 L2,16 L2,11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFullscreen, ElementName=ControlRoot}" Value="True">
                                            <Setter Property="Data" Value="M2,7 L7,7 L7,2 M11,2 L11,7 L16,7 M16,11 L11,11 L11,16 M7,16 L7,11 L2,11" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
