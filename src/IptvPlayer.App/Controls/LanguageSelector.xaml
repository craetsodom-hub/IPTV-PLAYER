<UserControl x:Class="IptvPlayer.App.Controls.LanguageSelector"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IptvPlayer.App.Localization"
             Focusable="True"
             PreviewKeyDown="LanguageSelector_OnPreviewKeyDown">
    <UserControl.Resources>
        <loc:FlagCodeToImageSourceConverter x:Key="FlagConverter" />

        <Style x:Key="LanguageButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1A2E48" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Padding="8,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding CheckmarkVisibility}" Value="Visible">
                                <Setter TargetName="RowBorder" Property="Background" Value="#182D49" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#345B82" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.SelectionBackground}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brush.SelectionBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="LanguageButton"
                Style="{StaticResource LanguageButtonStyle}"
                ToolTip="{loc:Loc LanguageButtonToolTip}"
                Click="LanguageButton_OnClick">
            <Border BorderBrush="{DynamicResource Brush.InputBorder}"
                    BorderThickness="0.6"
                    CornerRadius="2">
                <Image Width="20"
                       Height="13"
                       Stretch="Fill"
                       Source="{Binding CurrentFlagCode, ElementName=Root, Converter={StaticResource FlagConverter}}" />
            </Border>
        </Button>

        <Popup x:Name="LanguagePopup"
               PlacementTarget="{Binding ElementName=LanguageButton}"
               Placement="Bottom"
               VerticalOffset="6"
               FlowDirection="{Binding FlowDirection, ElementName=Root}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False"
               Opened="LanguagePopup_OnOpened">
            <Popup.Style>
                <Style TargetType="Popup">
                    <Setter Property="HorizontalOffset" Value="-214" />
                    <Style.Triggers>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter Property="HorizontalOffset" Value="0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Popup.Style>
            <Border Width="244"
                    MaxHeight="414"
                    Padding="8"
                    Background="{DynamicResource Brush.CardBackground}"
                    BorderBrush="{DynamicResource Brush.InputBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="14"
                                      ShadowDepth="4"
                                      Opacity="0.48" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="36"
                            Margin="0,0,0,8"
                            Padding="11,0,10,0"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#111F35" />
                                <Setter Property="BorderBrush" Value="#456A96" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="13"
                                     Height="13"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="False">
                                <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                      Stroke="{DynamicResource Brush.AccentHover}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="LanguageSearchBox"
                                         Height="34"
                                         MinHeight="0"
                                         Margin="0"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         CaretBrush="{DynamicResource Brush.AccentHover}"
                                         BorderThickness="0"
                                         FontSize="13"
                                         TextChanged="LanguageSearchBox_OnTextChanged" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="13"
                                           IsHitTestVisible="False"
                                           Text="{loc:Loc SearchLanguages}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=LanguageSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LanguageList"
                             Grid.Row="1"
                             MaxHeight="350"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource LanguageRowStyle}"
                             ItemsSource="{Binding FilteredLanguages, ElementName=Root}"
                             SelectionChanged="LanguageList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="24"
                                            Height="16"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Brush.InputBorder}"
                                            BorderThickness="0.6"
                                            CornerRadius="2">
                                        <Image Stretch="Fill"
                                               Source="{Binding FlagCode, Converter={StaticResource FlagConverter}}" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding NativeName}" />

                                    <Path Grid.Column="2"
                                          Width="11"
                                          Height="8"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M1,5 L4.5,8 L12,1"
                                          Stroke="{DynamicResource Brush.AccentHover}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="{Binding CheckmarkVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
