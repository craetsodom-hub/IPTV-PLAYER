<UserControl x:Class="IptvPlayer.App.Controls.PlayerActionIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="92"
             Height="92"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Button Width="92"
            Height="92"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Focusable="False"
            Command="{Binding TogglePlayPauseCommand}"
            ToolTip="{Binding PlayPauseToolTip}"
            AutomationProperties.Name="{Binding PlayPauseToolTip}"
            Visibility="{Binding IsPlayerActionIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </ControlTemplate>
        </Button.Template>
        <Grid Width="88"
              Height="88"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True">
        <Ellipse Margin="4"
                 Stroke="#E8FFFFFF"
                 StrokeThickness="1.4">
            <Ellipse.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="15"
                                  ShadowDepth="1"
                                  Opacity="0.72" />
            </Ellipse.Effect>
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#5EFFFFFF" Offset="0" />
                    <GradientStop Color="#26000000" Offset="0.46" />
                    <GradientStop Color="#72000000" Offset="1" />
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Margin="6"
                 Stroke="#40FFFFFF"
                 StrokeThickness="1" />

        <Grid Width="28"
              Height="38"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding IsPlayerPauseIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="9" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Height="34"
                    VerticalAlignment="Center"
                    CornerRadius="4.5"
                    Background="#F2FFFFFF" />
            <Border Grid.Column="2"
                    Height="34"
                    VerticalAlignment="Center"
                    CornerRadius="4.5"
                    Background="#F2FFFFFF" />
        </Grid>

        <Border Width="33"
                Height="33"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="#F2FFFFFF"
                Visibility="{Binding IsPlayerStopIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Button>
</UserControl>
