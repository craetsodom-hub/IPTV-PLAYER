{
  "Networking": {
    "DefaultRequestTimeoutSeconds": 12,
    "RetryCount": 2
  },
  "Caching": {
    "LogoCacheDays": 14,
    "MetadataCacheMinutes": 10
  },
  "Playback": {
    "NetworkCachingMs": 4000,
    "LiveCachingMs": 4000,
    "HttpReconnect": true
  },
  "PlaybackDiagnostics": {
    "Enabled": false,
    "ProbeEnabled": false
  }
}
