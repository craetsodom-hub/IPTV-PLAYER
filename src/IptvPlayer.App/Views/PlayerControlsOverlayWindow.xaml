<Window x:Class="IptvPlayer.App.Views.PlayerControlsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IptvPlayer.App.Controls"
        xmlns:loc="clr-namespace:IptvPlayer.App.Localization"
        Title="{loc:Loc PlayerControlsTitle}"
        Width="600"
        Height="82"
        MinWidth="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <controls:PlayerControlBar x:Name="ControlsBar"
                               Opacity="0"
                               IsHitTestVisible="False"
                               ActivityDetected="ControlsBar_OnActivityDetected"
                               ScreenshotRequested="ControlsBar_OnScreenshotRequested"
                               RecordRequested="ControlsBar_OnRecordRequested"
                               DisplayModeRequested="ControlsBar_OnDisplayModeRequested"
                               FullscreenRequested="ControlsBar_OnFullscreenRequested" />
</Window>
