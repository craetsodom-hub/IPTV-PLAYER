<Window x:Class="IptvPlayer.App.Views.FullscreenHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IptvPlayer.App.Localization"
        xmlns:controls="clr-namespace:IptvPlayer.App.Controls"
        Title="{loc:Loc FullscreenControls}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="FullscreenHudWindow_OnPreviewKeyDown"
        MouseMove="FullscreenHudWindow_OnMouseMove">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Key="HudButtonContentTemplate">
            <TextBlock Text="{Binding}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="16" />
        </DataTemplate>

        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Width" Value="124" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="46" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="ContentTemplate" Value="{StaticResource HudButtonContentTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.FFFFFFFF}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.CC17243A}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.663E8BFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Shape.CornerRadius.14}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.E8233B5F}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.AA69B1FF}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.F01B2D49}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomHudButtonStyle" TargetType="Button" BasedOn="{StaticResource HudButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Width" Value="96" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FullscreenBackIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.FFE8F1FF}" />
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.CC17243A}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.663E8BFF}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Shape.CornerRadius.14}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.E8233B5F}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.AA69B1FF}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.F01B2D49}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.FFE8F1FF}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HudTimelineSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.FF4EA2FF}" />
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.33FFFFFF}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="12,0"
                              ClipToBounds="False"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   Height="8"
                                   ClipToBounds="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{TemplateBinding Foreground}"
                                                  BorderThickness="0"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="{DynamicResource Shape.CornerRadius.4}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{TemplateBinding Background}"
                                                  BorderThickness="0"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="{DynamicResource Shape.CornerRadius.4}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22"
                                           Cursor="Hand"
                                           ClipToBounds="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22"
                                                      Height="22"
                                                      ClipToBounds="False"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse Fill="{DynamicResource Theme.Brush.FF08101D}"
                                                             Opacity="0.9" />
                                                    <Ellipse Stroke="{DynamicResource Theme.Brush.FF90C8FF}"
                                                             StrokeThickness="2"
                                                             Margin="1">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush Center="0.35,0.3"
                                                                                 GradientOrigin="0.35,0.3"
                                                                                 RadiusX="0.8"
                                                                                 RadiusY="0.8">
                                                                <GradientStop Color="{DynamicResource Theme.Color.FFFFFFFF}" Offset="0" />
                                                                <GradientStop Color="{DynamicResource Theme.Color.FFE8F1FF}" Offset="0.55" />
                                                                <GradientStop Color="{DynamicResource Theme.Color.FF90C8FF}" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.Brush.01000000}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="3"
              Background="{DynamicResource Theme.Brush.FF000000}"
              Panel.ZIndex="0"
              Visibility="{Binding IsFullscreenPlaybackLoadingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="72"
                  Height="72"
                  RenderTransformOrigin="0.5,0.5"
                  SnapsToDevicePixels="False"
                  UseLayoutRounding="False">
                <Grid.RenderTransform>
                    <RotateTransform Angle="0" />
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0"
                                                 To="360"
                                                 Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Stroke="{DynamicResource Brush.Accent}"
                         Opacity="0.2"
                         StrokeThickness="4" />
                <Path Stroke="{DynamicResource Brush.Accent}"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 36,6 A 30,30 0 1 1 14,56" />
            </Grid>
        </Grid>

        <TextBlock Grid.RowSpan="3"
                   Panel.ZIndex="0"
                   Text="{loc:Loc NoSignal}"
                   Foreground="{DynamicResource Theme.Brush.FFE8F1FF}"
                   FontSize="25"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="{Binding IsFullscreenNoSignalVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

        <controls:PlayerActionIndicator Grid.RowSpan="3"
                                        Panel.ZIndex="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

        <Grid x:Name="BottomChrome"
              Grid.Row="2"
              Panel.ZIndex="1">
            <controls:PlayerControlBar x:Name="FullscreenPlayerControlBar"
                                       IsFullscreen="True"
                                       ActivityDetected="PlayerControlBar_OnActivityDetected"
                                       ScreenshotRequested="PlayerControlBar_OnScreenshotRequested"
                                       RecordRequested="PlayerControlBar_OnRecordRequested"
                                       DisplayModeRequested="PlayerControlBar_OnDisplayModeRequested"
                                       FullscreenRequested="PlayerControlBar_OnFullscreenRequested" />
        </Grid>
    </Grid>
</Window>
