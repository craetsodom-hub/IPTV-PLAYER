                                  BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="{DynamicResource Design.Opacity.0_32}" />
            </Border.Effect>
            <TextBlock x:Name="MediaSavedToastText"
                       Text="{loc:Loc ScreenshotSaved}"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid x:Name="FullscreenOverlay"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource Theme.Brush.FF000000}"
              Visibility="Collapsed"
              MouseMove="FullscreenOverlay_OnMouseMove"
              Panel.ZIndex="200">
            <Grid x:Name="FullscreenHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource Theme.Brush.FF000000}" />

        </Grid>

        <!-- Startup Loading Overlay with Centered Card & Animated Loading Bar -->
        <Grid x:Name="StartupLoadingOverlay"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Margin="-16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource Brush.WindowBackground}"
              Panel.ZIndex="350"
              Visibility="Collapsed"
              Opacity="0">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="380"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <!-- Static cached background border with drop shadow (ZERO per-frame invalidations) -->
                <Border CornerRadius="20"
                        Background="{DynamicResource Theme.Brush.101A2C}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="32"
                                          ShadowDepth="4"
                                          Opacity="0.55" />
                    </Border.Effect>
                </Border>

                <!-- Foreground card content (animates at a flawless 60 FPS without triggering shadow redraws) -->
                <Border CornerRadius="20"
                        Padding="32,28"
                        Background="{DynamicResource Theme.Brush.101A2C}"
                        BorderBrush="{DynamicResource Theme.Brush.D4AF37}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <StackPanel HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14">
                            <Image Source="/IptvPlayer.App;component/Assets/WhoseIptv-256.png"
                                   Width="46"
                                   Height="46"
                                   Margin="0,0,12,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True" />
                            <TextBlock Text="Whose IPTV"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding StartupLoadingMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,18" />

                        <ProgressBar Style="{StaticResource StartupLoadingProgressBarStyle}"
                                     IsIndeterminate="{Binding IsStartupLoading}"
                                     Width="316"
                                     HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
