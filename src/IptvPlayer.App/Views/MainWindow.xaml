                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.StreamAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.357FD0}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnDemandSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandPrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.22FFFFFF}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="MinWidth" Value="122" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Theme.Brush.24FFFFFF}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Shape.CornerRadius.19}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.34FFFFFF}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme.Brush.40FFFFFF}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Theme.Brush.1CFFFFFF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPlayerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandSecondaryButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ContentTemplate" Value="{StaticResource FixedActionButtonContentTemplate}" />
        </Style>

        <Style x:Key="OnDemandCompactPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandPrimaryButtonStyle}">
            <Setter Property="Width" Value="118" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="OnDemandCompactResumeButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandSecondaryButtonStyle}">
            <Setter Property="Width" Value="118" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="OnDemandCompactWatchlistButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandCompactResumeButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="ContentTemplate" Value="{StaticResource SingleLineActionButtonContentTemplate}" />
        </Style>

        <Style x:Key="OnDemandGhostCardButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Shape.CornerRadius.14}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource Theme.Brush.10FFFFFF}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource Theme.Brush.18FFFFFF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="SearchFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.12FFFFFF}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Shape.CornerRadius.14}" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="HeaderSearchFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="11,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.111F35}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.456A96}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Shape.CornerRadius.18}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-8" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SourceColumn" Width="344" />
            <ColumnDefinition x:Name="ChannelColumn" Width="420" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SourcePanel" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">
                    <StackPanel Margin="0,0,0,12">
                        <Grid Margin="0,0,0,12"
                              FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc CurrentIptv}"
                                       Style="{StaticResource PanelTitleTextStyle}"
                                       Margin="0"
                                       HorizontalAlignment="Left"
                                       FlowDirection="{Binding FlowDirection, ElementName=RootLayout}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <controls:AppearanceSelector Margin="0,0,6,0"
                                                             FlowDirection="LeftToRight" />
                                <controls:LanguageSelector FlowDirection="{Binding FlowDirection, ElementName=RootLayout}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,12"
                              Height="36"
                              VerticalAlignment="Top"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Margin="0"
                                      Height="36"
                                      MinHeight="36"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Sources}"
                                      SelectedItem="{Binding SelectedSource}"
                                      DisplayMemberPath="Name" />

                            <Button x:Name="LeftPanelAddSourceButton"
                                    Grid.Column="1"
                                    Command="{Binding ToggleImportMenuCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="36"
                                    Height="36"
                                    MinHeight="36"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc AddPlaylist}">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M7.5,1.5 L7.5,13.5 M1.5,7.5 L13.5,7.5"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>

                            <Button x:Name="LeftPanelRefreshSourceButton"
                                    Grid.Column="2"
                                    Command="{Binding RefreshSelectedSourceCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="36"
                                    Height="36"
                                    MinHeight="36"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc RefreshSelectedPlaylist}">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M21,2 L21,8 L15,8 M3,12 A9,9 0 0,1 18,5.3 L21,8 M3,22 L3,16 L9,16 M21,12 A9,9 0 0,1 6,18.7 L3,16"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="2.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Button>

                            <Button Grid.Column="3"
                                    Command="{Binding EditSelectedSourceCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="36"
                                    Height="36"
                                    MinHeight="36"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc EditSelectedPlaylist}">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M3,11 L3,14 L6,14 L14,6 L11,3 Z M10,4 L13,7"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Button>

                            <Button Grid.Column="4"
                                    Command="{Binding DeleteSelectedSourceCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="36"
                                    Height="36"
                                    MinHeight="36"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc RemoveSelectedPlaylist}">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M10,3 L14,7 L10,11 M14,7 L5,7 M7,3 L7,2 L2,2 L2,12 L7,12 L7,11"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Button>

                            <Popup PlacementTarget="{Binding ElementName=LeftPanelAddSourceButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsImportMenuOpen, Mode=TwoWay}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Margin="0,6,0,0"
                                        Width="212"
                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource Brush.InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Shape.CornerRadius.14}"
                                        Padding="8">
                                    <StackPanel>
                                        <Button Content="Xtream Code"
                                                Command="{Binding AddXtreamSourceCommand}"
                                                Style="{StaticResource PopupMenuButtonStyle}" />
                                        <Button Content="M3U URL"
                                                Command="{Binding AddM3uUrlSourceCommand}"
                                                Style="{StaticResource PopupMenuButtonStyle}" />
                                        <Button Content="Import M3U File"
                                                Command="{Binding AddM3uFileSourceCommand}"
                                                Style="{StaticResource PopupMenuButtonStyle}"
                                                Margin="0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyTextStyle}">
                            <Run Text="{loc:Loc StatusLabel}" />
                            <Run Text="{Binding SelectedSource.StatusLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyTextStyle}">
                            <Run Text="{loc:Loc ExpiresLabel}" />
                            <Run Text="{Binding SelectedSource.ExpirationLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyTextStyle}">
                            <Run Text="{loc:Loc DaysRemainingLabel}" />
                            <Run Text="{Binding SelectedSource.DaysRemainingLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Button Command="{Binding SelectEventsSectionCommand}"
                            Style="{StaticResource GoldenEventsButtonStyle}"
                            Tag="{Binding IsEventsSection}"
                            Margin="0,0,0,8"
                            ToolTip="{loc:Loc TodaysEvents}">
                            <Grid>
                                <Grid Margin="0,2,0,0"
                                      HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="{DynamicResource Shape.CornerRadius.12}"
                                        Background="{DynamicResource Theme.Brush.24200F}"
                                        BorderBrush="{DynamicResource Theme.Brush.D4AF37}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource Theme.Color.D4AF37}"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="{DynamicResource Design.Opacity.0_42}" />
                                    </Border.Effect>
                                    <Viewbox Width="21" Height="21">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,4 L18,4 C19.1,4 20,4.9 20,6 L20,18 C20,19.1 19.1,20 18,20 L6,20 C4.9,20 4,19.1 4,18 L4,6 C4,4.9 4.9,4 6,4 Z"
                                                  Fill="{DynamicResource Theme.Brush.15120A}"
                                                  Stroke="{DynamicResource Theme.Brush.F5C84B}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round" />
                                            <Path Data="M4.5,8 L19.5,8 M8,3 L8,6 M16,3 L16,6"
                                                  Stroke="{DynamicResource Theme.Brush.FFE59A}"
                                                  StrokeThickness="1.45"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <Path Data="M12,10.2 L13.05,12.35 L15.4,12.7 L13.7,14.35 L14.1,16.7 L12,15.6 L9.9,16.7 L10.3,14.35 L8.6,12.7 L10.95,12.35 Z"
                                                  Fill="{DynamicResource Theme.Brush.F5C84B}"
                                                  Stroke="{DynamicResource Theme.Brush.FFE59A}"
                                                  StrokeThickness="0.75"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc TodaysEvents}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Gold}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Button>

                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="98" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Width="98"
                                Height="34"
                                Margin="0"
                                Padding="8,7"
                                Content="{loc:Loc BrowseLiveTvTab}"
                                Command="{Binding SelectLiveTvSectionCommand}" />
                        <Button Grid.Column="2"
                                Width="98"
                                Height="34"
                                Margin="0"
                                Padding="8,7"
                                Content="{loc:Loc BrowseMoviesTab}"
                                Command="{Binding SelectMoviesSectionCommand}" />
                        <Button Grid.Column="4"
                                Width="98"
                                Height="34"
                                Padding="8,7"
                                Content="{loc:Loc BrowseSeriesTab}"
                                Command="{Binding SelectSeriesSectionCommand}"
                                Margin="0" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        BorderBrush="{DynamicResource Brush.InputBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Shape.CornerRadius.10}"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsImportPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ImportTitle}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Height="42"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />

                            <TextBlock Text="{loc:Loc PlaylistName}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding PlaylistDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Visibility="{Binding IsXtreamImportMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{loc:Loc ServerUrl}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding XtreamServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Username}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding XtreamUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Password}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding XtreamPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsPlaylistImportMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding PlaylistInputLabel}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding PlaylistInputHint}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding PlaylistInput, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsPlaylistTextInputVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Grid Visibility="{Binding IsM3uFileImportMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Theme.Brush.12FFFFFF}"
                                        CornerRadius="{DynamicResource Shape.CornerRadius.10}"
                                        Padding="10,8"
                                        MinHeight="34">
                                    <TextBlock Text="{Binding PlaylistInput}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{loc:Loc Choose}"
                                        Click="ChooseM3uFileButton_OnClick"
                                        Width="88"
                                        Height="36"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,2,0,8"
                              Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Importing playlist"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ImportProgressPercent, StringFormat={}{0:0}%}"
                                       Foreground="{DynamicResource Brush.AccentHover}"
                                       FontSize="12" />
                            <ProgressBar Grid.Row="1"
                                         Grid.ColumnSpan="2"
                                         Value="{Binding ImportProgressPercent}"
                                         Style="{StaticResource ImportProgressBarStyle}"
                                         Margin="0,4,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding ImportFeedback}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SubmitImportButtonText}"
                                    Command="{Binding SubmitImportCommand}"
                                    Width="192"
                                    Height="36" />
                            <Button Content="{loc:Loc Cancel}"
                                    Command="{Binding CancelImportCommand}"
                                    Width="88"
                                    Height="36"
                                    Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsPlaylistCategoriesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Height="34"
                          Margin="0,0,0,8"
                          ClipToBounds="True">
                        <TextBlock Text="{loc:Loc Categories}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Button Command="{Binding SelectFavoritesCategoryCommand}"
                            Style="{StaticResource NavigationBuiltInCategoryButtonStyle}"
                            Tag="{Binding IsFavoritesCategorySelected}"
                            Visibility="{Binding HasLoadedLiveTvPlaylist, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="{loc:Loc ShowFavoriteChannels}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Favorites}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding FavoriteChannelsCount}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="12,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="3"
                      Visibility="{Binding IsPlaylistCategoriesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="LiveCategoryList"
                             ItemsSource="{Binding VisibleCategories}"
                             SelectedItem="{Binding SelectedCategory}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="1,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel"
                             ItemContainerStyle="{StaticResource NavigationCategoryItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Categories}" Style="{StaticResource SectionTitleTextStyle}" />
                    <Button Command="{Binding SelectMovieWatchlistCommand}"
                            Style="{StaticResource NavigationBuiltInCategoryButtonStyle}"
                            Tag="{Binding IsMovieWatchlistSelected}"
                            ToolTip="{loc:Loc ShowSavedMovies}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Watchlist}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SavedMoviesCount}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="12,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="3"
                      Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="MovieCategoryList"
                             ItemsSource="{Binding MovieCategories}"
                             SelectedItem="{Binding SelectedMovieCategory}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="1,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel"
                             ItemContainerStyle="{StaticResource NavigationCategoryItemStyle}">
                        <ListBox.ItemTemplate>
