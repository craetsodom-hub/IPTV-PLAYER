                                    <Image Width="56"
                                           Height="56"
                                           Source="{Binding SelectedSportsEvent.ArtworkUri, IsAsync=True}"
                                           Stretch="Uniform"
                                           CacheMode="BitmapCache"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SelectedSportsEvent.HasStandaloneArtwork, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedSportsEvent.Title}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               LineHeight="26"
                                               MaxHeight="58"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding SelectedSportsEvent.Competition}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,10"
                                           Visibility="{Binding SelectedSportsEvent.HasCompetition, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Grid Grid.Row="3"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding SelectedSportsEvent.CountryOptions}"
                                              SelectedItem="{Binding SelectedSportsEvent.SelectedCountryOption, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource EventCountrySelectorItemTemplate}"
                                              Style="{StaticResource EventCountrySelectorComboBoxStyle}"
                                              Visibility="{Binding IsEventCountrySelectorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource Theme.Brush.24FFD166}"
                                            BorderBrush="{DynamicResource Theme.Brush.78FFD166}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Shape.CornerRadius.12}"
                                            Padding="10,7"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedSportsEvent.TimeLabel}"
                                                   Foreground="{DynamicResource Brush.Gold}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Row="4"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="SmoothList_OnPreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding SelectedSportsEvent.VisibleChannelGroups}"
                                                  Visibility="{Binding IsEventChannelContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Button HorizontalContentAlignment="Stretch"
                                                            Margin="0,0,0,8"
                                                            Padding="12,10"
                                                            BorderBrush="{DynamicResource Theme.Brush.574EA2FF}"
                                                            Background="{DynamicResource Theme.Brush.164EA2FF}"
                                                            Command="{Binding DataContext.PlayEventChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Representative}"
                                                            Visibility="{Binding HasSingleVariant, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid MinHeight="40">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="{DynamicResource Shape.CornerRadius.10}"
                                                                    Background="{DynamicResource Brush.SurfaceRaised}"
                                                                    ClipToBounds="True"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="{loc:Loc TvShort}"
                                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Image converters:ImageAsyncHelper.SourceUri="{Binding Representative.Channel.LogoUri}"
                                                                           Source="{Binding Representative.Channel.LogoUri, Converter={StaticResource CachedLogoConverter}}"
                                                                           Stretch="Uniform"
                                                                           Margin="2"
                                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="0,0,10,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="14"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding Representative.Channel.CountryPrefixFreeDisplayName}" />
                                                                <TextBlock Foreground="{DynamicResource Brush.TextMuted}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding CanonicalName}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Foreground="{DynamicResource Brush.AccentHover}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0,0,0"
                                                                       Text="{Binding TerritoryLabel}" />
                                                        </Grid>
                                                    </Button>

                                                    <StackPanel Visibility="{Binding HasMultipleVariants, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Button HorizontalContentAlignment="Stretch"
                                                                Margin="0,0,0,4"
                                                                Padding="12,10"
                                                                BorderBrush="{DynamicResource Theme.Brush.574EA2FF}"
                                                                Background="{DynamicResource Theme.Brush.164EA2FF}"
                                                                Command="{Binding ToggleCommand}">
                                                            <Grid MinHeight="40">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="40"
                                                                        Height="40"
                                                                        CornerRadius="{DynamicResource Shape.CornerRadius.10}"
                                                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                                                        ClipToBounds="True"
                                                                        VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="{loc:Loc TvShort}"
                                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                        <Image converters:ImageAsyncHelper.SourceUri="{Binding Representative.Channel.LogoUri}"
                                                                               Source="{Binding Representative.Channel.LogoUri, Converter={StaticResource CachedLogoConverter}}"
                                                                               Stretch="Uniform"
                                                                               Margin="2"
                                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="0,0,10,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="14"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding CanonicalName}" />
                                                                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}"
                                                                               FontSize="12"
                                                                               Text="{Binding VariantCount, StringFormat={}{0} streams}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Foreground="{DynamicResource Brush.AccentHover}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="12,0,0,0"
                                                                           Text="{Binding TerritoryLabel}" />
                                                                <Border Grid.Column="3"
                                                                        Width="28"
                                                                        Height="28"
                                                                        Margin="8,0,0,0"
                                                                        Background="{DynamicResource Theme.Brush.1CFFFFFF}"
                                                                        BorderBrush="{DynamicResource Theme.Brush.4DFFFFFF}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{DynamicResource Shape.CornerRadius.8}"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ExpansionGlyph}"
                                                                               Foreground="{DynamicResource Brush.AccentHover}"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                        <ItemsControl Margin="18,0,0,8"
                                                                      ItemsSource="{Binding Variants}"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button HorizontalContentAlignment="Stretch"
                                                                            Margin="0,2,0,2"
                                                                            Padding="10,8"
                                                                            BorderBrush="{DynamicResource Brush.CardBorder}"
                                                                            Background="{DynamicResource Brush.SurfaceRaised}"
                                                                            Command="{Binding DataContext.PlayEventChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Grid MinHeight="32">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="40" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Width="32"
                                                                                    Height="32"
                                                                                    CornerRadius="{DynamicResource Shape.CornerRadius.8}"
                                                                                    Background="{DynamicResource Brush.CardBackground}"
                                                                                    ClipToBounds="True"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <TextBlock Text="{loc:Loc TvShort}"
                                                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                    <Image converters:ImageAsyncHelper.SourceUri="{Binding Channel.LogoUri}"
                                                                                           Source="{Binding Channel.LogoUri, Converter={StaticResource CachedLogoConverter}}"
                                                                                           Stretch="Uniform"
                                                                                           Margin="2"
                                                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1"
                                                                                        Margin="0,0,8,0"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                                                                            FontWeight="SemiBold"
                                                                                            FontSize="13"
                                                                                            TextTrimming="CharacterEllipsis"
                                                                                            Text="{Binding Channel.CountryPrefixFreeDisplayName}" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="2"
                                                                                        Foreground="{DynamicResource Brush.AccentHover}"
                                                                                        FontSize="11"
                                                                                        VerticalAlignment="Center"
                                                                                        Text="{Binding TerritoryLabel}" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Grid.Row="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsSelectedEventChannelsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Width="52"
                                          Height="52"
                                          HorizontalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"
                                          SnapsToDevicePixels="False"
                                          UseLayoutRounding="False">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Grid.RenderTransform>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedEventChannelsLoading}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="EventChannelsLoadingStoryboard">
                                                                <Storyboard RepeatBehavior="Forever"
                                                                            Timeline.DesiredFrameRate="60">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0"
                                                                                     To="360"
                                                                                     Duration="0:0:0.8" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="EventChannelsLoadingStoryboard" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Ellipse Stroke="{DynamicResource Brush.Accent}"
                                                 Opacity="0.2"
                                                 StrokeThickness="4" />
                                        <Path Stroke="{DynamicResource Brush.Accent}"
                                              StrokeThickness="4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 26,4 A 22,22 0 1 1 10,42" />
                                    </Grid>
                                    <TextBlock Text="Loading channels"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="5"
                                           Text="{loc:Loc NoMatchingChannelForCountry}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding IsNoMatchingEventChannelVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource Brush.CardBackground}"
                                BorderBrush="{DynamicResource Brush.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Shape.CornerRadius.16}"
                                Padding="24"
                                Width="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasEventsError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EventsErrorMessage}"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc TryAgainLater}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.CardBackground}"
                                BorderBrush="{DynamicResource Brush.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Shape.CornerRadius.16}"
                                Padding="24"
                                Width="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEventsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EventsEmptyTitle}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.RowSpan="2"
                      Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid Height="36" Margin="0,0,0,8">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMovieSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Movies}"
                                           Style="{StaticResource PanelTitleTextStyle}"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MovieResultSummary}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           FontSize="12"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Command="{Binding ShowMovieSearchCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="{loc:Loc SearchMovies}">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                              Stroke="{DynamicResource Brush.TextPrimary}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <controls:InlineSearchField Text="{Binding MovieSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CloseCommand="{Binding CloseMovieSearchCommand}"
                                                        Placeholder="{loc:Loc SearchMovies}"
                                                        ClearToolTip="{loc:Loc CloseSearch}"
                                                        Margin="0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsMovieSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <Border Background="{DynamicResource Theme.Brush.0F1A2C}"
                                BorderBrush="{DynamicResource Theme.Brush.233B5B}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Shape.CornerRadius.18}"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasContinueWatchingMovies, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Height="36"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc ContinueWatching}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleMovieContinueWatchingCommand}"
                                            Style="{StaticResource ContinueWatchingToggleButtonStyle}"
                                            Tag="{Binding IsMovieContinueWatchingExpanded}">
                                        <Viewbox Width="15" Height="15">
                                            <Path Style="{StaticResource ContinueWatchingChevronPathStyle}" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              MaxHeight="132"
                                              Margin="0,10,0,0"
                                              Visibility="{Binding IsMovieContinueWatchingExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding ContinueWatchingMovies}"
                                                  Margin="0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.PlayContinueWatchingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ContinueWatchingCardButtonStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="46"
                                                                Height="62"
                                                                Background="{DynamicResource Brush.SurfaceRaised}"
                                                                CornerRadius="{DynamicResource Shape.CornerRadius.9}"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding PosterUri, IsAsync=True}"
                                                                   Style="{StaticResource ContinueWatchingPosterImageStyle}"
                                                                   CacheMode="BitmapCache" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SubtitleText}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                                       FontSize="10"
                                                                       Margin="0,3,0,0"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="3"
                                                                         Margin="0,8,0,0"
                                                                         Foreground="{DynamicResource Brush.StreamAccent}"
                                                                         Background="{DynamicResource Theme.Brush.24FFFFFF}"
                                                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Theme.Brush.16FFFFFF}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource Shape.CornerRadius.14}"
                                Padding="14"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasMovieError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding MovieErrorMessage}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource Theme.Brush.12FFFFFF}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource Shape.CornerRadius.18}"
                                Padding="22"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsMovieEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54"
                                        Height="54"
                                        CornerRadius="{DynamicResource Shape.CornerRadius.20}"
                                        Background="{DynamicResource Theme.Brush.204EA2FF}"
                                        BorderBrush="{DynamicResource Theme.Brush.3A69B1FF}"
                                        BorderThickness="1"
                                        Margin="0,0,0,12">
                                    <Viewbox Width="25" Height="25">
                                        <Path Data="M6,3 L18,3 L18,21 L12,17.2 L6,21 Z"
                                              Fill="{DynamicResource Brush.AccentHover}"
                                              Stroke="{DynamicResource Brush.TextPrimary}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{Binding MovieEmptyStateTitle}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding MovieEmptyStateMessage}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox x:Name="MovieList"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleMovies}"
                             SelectedItem="{Binding SelectedMovie}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="1,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovieSkeletonVisible}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.38" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingUniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource OnDemandPosterItemStyle}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="104" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource OnDemandPosterFrameStyle}">
                                        <Image Source="{Binding PosterUri, IsAsync=True}"
                                               Style="{StaticResource OnDemandPosterImageStyle}"
                                               CacheMode="BitmapCache" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,8,2,2" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ContentControl Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource OnDemandCatalogSkeletonTemplate}"
                                    IsHitTestVisible="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovieSkeletonVisible}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
