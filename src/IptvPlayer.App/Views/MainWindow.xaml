        <Style x:Key="GoldenEventsButtonStyle" TargetType="Button" BasedOn="{StaticResource BuiltInCategoryButtonStyle}">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="{DynamicResource Theme.Brush.101A2C}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.F5C84B}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Container"
                              RenderTransformOrigin="0.5,0.5"
                              SnapsToDevicePixels="True">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                            <Grid.Effect>
                                <DropShadowEffect Color="{DynamicResource Theme.Color.000000}"
                                                  BlurRadius="4"
                                                  ShadowDepth="2"
                                                  Opacity="{DynamicResource Design.Opacity.0_58}" />
                            </Grid.Effect>
                            <Border x:Name="Glow"
                                    Margin="0"
                                    CornerRadius="{DynamicResource Shape.CornerRadius.16}"
                                    Opacity="{DynamicResource Design.Opacity.0_24}"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource Theme.Color.007A4D08}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FFD4AF37}" Offset="0.34" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FFFFE59A}" Offset="0.5" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FFD4AF37}" Offset="0.66" />
                                        <GradientStop Color="{DynamicResource Theme.Color.009C6510}" Offset="1" />
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="GlowRotate" CenterX="0.5" CenterY="0.5" />
                                        </LinearGradientBrush.RelativeTransform>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="GradientShell"
                                    Padding="2"
                                    CornerRadius="{DynamicResource Shape.CornerRadius.16}"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource Theme.Color.007A4D08}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FF7A4D08}" Offset="0.18" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FFD4AF37}" Offset="0.35" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FFFFE59A}" Offset="0.48" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FFD4AF37}" Offset="0.58" />
                                        <GradientStop Color="{DynamicResource Theme.Color.007A4D08}" Offset="0.72" />
                                        <GradientStop Color="{DynamicResource Theme.Color.FF9C6510}" Offset="0.9" />
                                        <GradientStop Color="{DynamicResource Theme.Color.007A4D08}" Offset="1" />
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="MovingBorderRotate" CenterX="0.5" CenterY="0.5" />
                                        </LinearGradientBrush.RelativeTransform>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border x:Name="ButtonSurface"
                                        CornerRadius="{DynamicResource Shape.CornerRadius.14}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{DynamicResource Theme.Color.17253B}" Offset="0" />
                                            <GradientStop Color="{DynamicResource Theme.Color.101A2C}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="{DynamicResource Design.Opacity.0_58}" />
                                <Setter TargetName="ButtonSurface" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{DynamicResource Theme.Color.1D304A}" Offset="0" />
                                            <GradientStop Color="{DynamicResource Theme.Color.132238}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="{DynamicResource Design.Opacity.0_22}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="{DynamicResource Design.Opacity.0_18}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Container" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MovingBorderRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:5" />
                                        <DoubleAnimation Storyboard.TargetName="GlowRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
