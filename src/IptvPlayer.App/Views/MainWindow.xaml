                                    ClipToBounds="True"
                                    Margin="0,13,0,16">
                                <ContentControl Style="{StaticResource OnDemandSkeletonFillStyle}" />
                            </Border>
                            <Border Width="250"
                                    Height="10"
                                    HorizontalAlignment="Left"
                                    Background="#1B2B43"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <ContentControl Style="{StaticResource OnDemandSkeletonFillStyle}" />
                            </Border>
                            <Border Width="224"
                                    Height="10"
                                    HorizontalAlignment="Left"
                                    Background="#1B2B43"
                                    CornerRadius="5"
                                    ClipToBounds="True"
                                    Margin="0,8,0,0">
                                <ContentControl Style="{StaticResource OnDemandSkeletonFillStyle}" />
                            </Border>
                            <Border Width="198"
                                    Height="10"
                                    HorizontalAlignment="Left"
                                    Background="#1B2B43"
                                    CornerRadius="5"
                                    ClipToBounds="True"
                                    Margin="0,8,0,0">
                                <ContentControl Style="{StaticResource OnDemandSkeletonFillStyle}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Width="118"
                                        Height="38"
                                        Background="#24466D"
                                        CornerRadius="19"
                                        ClipToBounds="True"
                                        Margin="0,0,10,0">
                                    <ContentControl Style="{StaticResource OnDemandSkeletonPillFillStyle}" />
                                </Border>
                                <Border Width="142"
                                        Height="38"
                                        Background="#1B2B43"
                                        CornerRadius="19"
                                        ClipToBounds="True">
                                    <ContentControl Style="{StaticResource OnDemandSkeletonPillFillStyle}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="OnDemandPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource Brush.StreamAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush.StreamAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#357FD0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnDemandSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandPrimaryButtonStyle}">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="MinWidth" Value="122" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="19">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#34FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPlayerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandSecondaryButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ContentTemplate" Value="{StaticResource FixedActionButtonContentTemplate}" />
        </Style>

        <Style x:Key="OnDemandCompactPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandPrimaryButtonStyle}">
            <Setter Property="Width" Value="110" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="OnDemandCompactResumeButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandSecondaryButtonStyle}">
            <Setter Property="Width" Value="110" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="OnDemandCompactWatchlistButtonStyle" TargetType="Button" BasedOn="{StaticResource OnDemandCompactResumeButtonStyle}" />

        <Style x:Key="OnDemandGhostCardButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="SearchFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="HeaderSearchFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="11,0,8,0" />
            <Setter Property="Background" Value="#111F35" />
            <Setter Property="BorderBrush" Value="#456A96" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-8" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SourceColumn" Width="344" />
            <ColumnDefinition x:Name="ChannelColumn" Width="420" />
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SourcePanel" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="0,0,0,10"
                          FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc CurrentIptv}"
                                   Style="{StaticResource PanelTitleTextStyle}"
                                   Margin="0"
                                   HorizontalAlignment="Left"
                                   FlowDirection="{Binding FlowDirection, ElementName=RootLayout}"
                                   VerticalAlignment="Center" />
                        <controls:LanguageSelector Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FlowDirection="{Binding FlowDirection, ElementName=RootLayout}" />
                    </Grid>

                    <Grid Margin="0,8,0,12"
                          Height="36"
                          VerticalAlignment="Top"
                          SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Margin="0"
                                  Height="36"
                                  MinHeight="36"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="Name" />

                        <Button x:Name="AddSourceButton"
                                Grid.Column="1"
                                Command="{Binding ToggleImportMenuCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36"
                                Height="36"
                                MinHeight="36"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{loc:Loc AddPlaylist}">
                            <Viewbox Width="15" Height="15">
                                <Path Data="M7.5,1.5 L7.5,13.5 M1.5,7.5 L13.5,7.5"
                                      Stroke="{DynamicResource Brush.TextPrimary}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding EditSelectedSourceCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36"
                                Height="36"
                                MinHeight="36"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{loc:Loc EditSelectedPlaylist}">
                            <Viewbox Width="15" Height="15">
                                <Path Data="M3,11 L3,14 L6,14 L14,6 L11,3 Z M10,4 L13,7"
                                      Stroke="{DynamicResource Brush.TextPrimary}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>

                        <Button Grid.Column="3"
                                Command="{Binding DeleteSelectedSourceCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="36"
                                Height="36"
                                MinHeight="36"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{loc:Loc RemoveSelectedPlaylist}">
                            <Viewbox Width="15" Height="15">
                                <Path Data="M10,3 L14,7 L10,11 M14,7 L5,7 M7,3 L7,2 L2,2 L2,12 L7,12 L7,11"
                                      Stroke="{DynamicResource Brush.TextPrimary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>

                        <Popup PlacementTarget="{Binding ElementName=AddSourceButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsImportMenuOpen, Mode=TwoWay}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <Border Margin="0,6,0,0"
                                    Width="212"
                                    Background="{DynamicResource Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource Brush.InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="8">
                                <StackPanel>
                                    <Button Content="Xtream"
                                            Command="{Binding AddXtreamSourceCommand}"
                                            Style="{StaticResource PopupMenuButtonStyle}" />
                                    <Button Content="M3U URL"
                                            Command="{Binding AddM3uUrlSourceCommand}"
                                            Style="{StaticResource PopupMenuButtonStyle}" />
                                    <Button Content="{loc:Loc ImportM3uFile}"
                                            Command="{Binding AddM3uFileSourceCommand}"
                                            Style="{StaticResource PopupMenuButtonStyle}"
                                            Margin="0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyTextStyle}">
                        <Run Text="{loc:Loc StatusLabel}" />
                        <Run Text="{Binding SelectedSource.StatusLabel, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource BodyTextStyle}">
                        <Run Text="{loc:Loc ExpiresLabel}" />
                        <Run Text="{Binding SelectedSource.ExpirationLabel, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,12" Style="{StaticResource BodyTextStyle}">
                        <Run Text="{loc:Loc DaysRemainingLabel}" />
                        <Run Text="{Binding SelectedSource.DaysRemainingLabel, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{loc:Loc Browse}" Style="{StaticResource SectionTitleTextStyle}" />
                        <Grid Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="98" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="98" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="98" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Width="98"
                                    Height="34"
                                    Margin="0"
                                    Padding="8,7"
                                    Content="{loc:Loc BrowseLiveTvTab}"
                                    Command="{Binding SelectLiveTvSectionCommand}" />
                            <Button Grid.Column="2"
                                    Width="98"
                                    Height="34"
                                    Margin="0"
                                    Padding="8,7"
                                    Content="{loc:Loc BrowseMoviesTab}"
                                    Command="{Binding SelectMoviesSectionCommand}" />
                            <Button Grid.Column="4"
                                    Width="98"
                                    Height="34"
                                    Padding="8,7"
                                    Content="{loc:Loc BrowseSeriesTab}"
                                    Command="{Binding SelectSeriesSectionCommand}"
                                    Margin="0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        BorderBrush="{DynamicResource Brush.InputBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsImportPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ImportTitle}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Height="42"
                                   LineHeight="20"
                                   TextWrapping="Wrap" />

                            <TextBlock Text="{loc:Loc PlaylistName}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding PlaylistDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Visibility="{Binding IsXtreamImportMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{loc:Loc ServerUrl}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding XtreamServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Username}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding XtreamUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Loc Password}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding XtreamPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsPlaylistImportMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding PlaylistInputLabel}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding PlaylistInputHint}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding PlaylistInput, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsPlaylistTextInputVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Grid Visibility="{Binding IsM3uFileImportMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#12FFFFFF"
                                        CornerRadius="10"
                                        Padding="10,8"
                                        MinHeight="34">
                                    <TextBlock Text="{Binding PlaylistInput}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{loc:Loc Choose}"
                                        Click="ChooseM3uFileButton_OnClick"
                                        Width="88"
                                        Height="36"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding ImportFeedback}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,2,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SubmitImportButtonText}"
                                    Command="{Binding SubmitImportCommand}"
                                    Width="192"
                                    Height="36" />
                            <Button Content="{loc:Loc Cancel}"
                                    Command="{Binding CancelImportCommand}"
                                    Width="88"
                                    Height="36"
                                    Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Categories}"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding ShowCategorySearchCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{loc:Loc SearchCategories}">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                      Stroke="{DynamicResource Brush.TextPrimary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                    </Grid>
                    <Button Command="{Binding SelectFavoritesCategoryCommand}"
                            Style="{StaticResource BuiltInCategoryButtonStyle}"
                            Tag="{Binding IsFavoritesCategorySelected}"
                            Visibility="{Binding HasLoadedLiveTvPlaylist, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="{loc:Loc ShowFavoriteChannels}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="12"
                                    Background="#204EA2FF"
                                    BorderBrush="#3A69B1FF"
                                    BorderThickness="1">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="M12,2 L14.95,8.65 L22,9.25 L16.65,13.9 L18.25,21 L12,17.3 L5.75,21 L7.35,13.9 L2,9.25 L9.05,8.65 Z"
                                          Fill="{DynamicResource Brush.AccentHover}"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.3"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Favorites}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{loc:Loc SavedChannels}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding FavoritesCategorySummary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Height="1"
                            Background="#1AFFFFFF"
                            Margin="4,0,4,10"
                            Visibility="{Binding HasLoadedLiveTvPlaylist, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Style="{StaticResource SearchFieldBorderStyle}"
                            Visibility="{Binding IsCategorySearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="0"
                                         IsVisibleChanged="SearchTextBox_OnIsVisibleChanged" />
                            <Button Grid.Column="1"
                                    Content="X"
                                    Command="{Binding CloseCategorySearchCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="6,2,0,2"
                                        ToolTip="{loc:Loc CloseSearch}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3"
                      Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="LiveCategoryList"
                             ItemsSource="{Binding VisibleCategories}"
                             SelectedItem="{Binding SelectedCategory}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel"
                             ItemContainerStyle="{StaticResource OnDemandCategoryItemStyle}">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CategoryScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc MovieCollections}" Style="{StaticResource SectionTitleTextStyle}" />
                    <Button Command="{Binding SelectMovieWatchlistCommand}"
                            Style="{StaticResource BuiltInCategoryButtonStyle}"
                            Tag="{Binding IsMovieWatchlistSelected}"
                                    ToolTip="{loc:Loc ShowSavedMovies}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="12"
                                    Background="#204EA2FF"
                                    BorderBrush="#3A69B1FF"
                                    BorderThickness="1">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="M6,3 L18,3 L18,21 L12,17.2 L6,21 Z"
                                          Fill="{DynamicResource Brush.AccentHover}"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding MovieWatchlistHeaderText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MovieWatchlistCountSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                        </Grid>
                    </Button>
                                <TextBlock Text="{loc:Loc BrowseByGenre}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>

                <Grid Grid.Row="3"
                      Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="MovieCategoryList"
                             ItemsSource="{Binding MovieCategories}"
                             SelectedItem="{Binding SelectedMovieCategory}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel"
                             ItemContainerStyle="{StaticResource OnDemandCategoryItemStyle}">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CategoryScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsSeriesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc SeriesCollections}" Style="{StaticResource SectionTitleTextStyle}" />
                    <Button Command="{Binding SelectSeriesWatchlistCommand}"
                            Style="{StaticResource BuiltInCategoryButtonStyle}"
                            Tag="{Binding IsSeriesWatchlistSelected}"
                                    ToolTip="{loc:Loc ShowSavedSeries}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="12"
                                    Background="#204EA2FF"
                                    BorderBrush="#3A69B1FF"
                                    BorderThickness="1">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="M6,3 L18,3 L18,21 L12,17.2 L6,21 Z"
                                          Fill="{DynamicResource Brush.AccentHover}"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SeriesWatchlistHeaderText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SeriesWatchlistCountSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                        </Grid>
                    </Button>
                                <TextBlock Text="{loc:Loc BrowseByGenre}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>

                <Grid Grid.Row="3"
                      Visibility="{Binding IsSeriesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox x:Name="SeriesCategoryList"
                             ItemsSource="{Binding SeriesCategories}"
                             SelectedItem="{Binding SelectedSeriesCategory}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel"
                             ItemContainerStyle="{StaticResource OnDemandCategoryItemStyle}">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CategoryScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ChannelPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Channels}"
                                   Style="{StaticResource PanelTitleTextStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding ShowChannelSearchCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                        ToolTip="{loc:Loc SearchChannels}">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                      Stroke="{DynamicResource Brush.TextPrimary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource SearchFieldBorderStyle}"
                            Visibility="{Binding IsChannelSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ChannelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0"
                                     IsVisibleChanged="SearchTextBox_OnIsVisibleChanged" />
                            <Button Grid.Column="1"
                                    Content="X"
                                    Command="{Binding CloseChannelSearchCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="6,2,0,2"
                                        ToolTip="{loc:Loc CloseSearch}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <ListBox x:Name="ChannelList"
                         Grid.Row="1"
                         ItemsSource="{Binding VisibleChannels}"
                         SelectedItem="{Binding SelectedChannel}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="1,2"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         ScrollViewer.CanContentScroll="True"
                         PreviewMouseWheel="SmoothList_OnPreviewMouseWheel"
                         Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2"
                                  MinHeight="50"
                                  ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceRaised}">
                                    <Image Source="{Binding LogoUri}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,10,0"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentProgram}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               FontSize="12"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource FavoriteIconButtonStyle}"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding IsFavorite}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <Viewbox Width="17" Height="17">
                                        <Path Data="M12,2 L14.95,8.65 L22,9.25 L16.65,13.9 L18.25,21 L12,17.3 L5.75,21 L7.35,13.9 L2,9.25 L9.05,8.65 Z"
                                              StrokeThickness="1.55"
                                              StrokeLineJoin="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.AccentHover}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.TextPrimary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.RowSpan="2"
                      Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid Height="36" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{loc:Loc Movies}"
                                       Margin="0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMovieSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Grid.Column="0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource HeaderSearchFieldBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMovieSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Opacity" Value="1" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0"
                                                                             To="1"
                                                                             Duration="0:0:0.16" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="-8"
                                                                             To="0"
                                                                             Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                        <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                              Stroke="{DynamicResource Brush.AccentHover}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Viewbox>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MovieSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource Brush.TextPrimary}"
                                             CaretBrush="{DynamicResource Brush.AccentHover}"
                                             FontSize="13"
                                             Margin="0"
                                             VerticalContentAlignment="Center"
                                             IsVisibleChanged="SearchTextBox_OnIsVisibleChanged" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MovieResultSummary}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="12"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Command="{Binding ShowMovieSearchCommand}"
                                        ToolTip="{loc:Loc SearchMovies}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMovieSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding CloseMovieSearchCommand}"
                                        ToolTip="{loc:Loc CloseSearch}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMovieSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="13" Height="13">
                                    <Path Data="M2,2 L12,12 M12,2 L2,12"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                        </Grid>

                        <Border Background="#0F1A2C"
                                BorderBrush="#233B5B"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasContinueWatchingMovies, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Height="36"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc ContinueWatching}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleMovieContinueWatchingCommand}"
                                            Style="{StaticResource ContinueWatchingToggleButtonStyle}"
                                            Tag="{Binding IsMovieContinueWatchingExpanded}">
                                        <Viewbox Width="15" Height="15">
                                            <Path Style="{StaticResource ContinueWatchingChevronPathStyle}" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              MaxHeight="132"
                                              Margin="0,10,0,0"
                                              Visibility="{Binding IsMovieContinueWatchingExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding ContinueWatchingMovies}"
                                                  Margin="0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.PlayContinueWatchingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ContinueWatchingCardButtonStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="46"
                                                                Height="62"
                                                                Background="{DynamicResource Brush.SurfaceRaised}"
                                                                CornerRadius="9"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding PosterUri, IsAsync=True}"
                                                                   Style="{StaticResource ContinueWatchingPosterImageStyle}"
                                                                   CacheMode="BitmapCache" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SubtitleText}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                                       FontSize="10"
                                                                       Margin="0,3,0,0"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="3"
                                                                         Margin="0,8,0,0"
                                                                         Foreground="{DynamicResource Brush.StreamAccent}"
                                                                         Background="#24FFFFFF"
                                                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Background="#16FFFFFF"
                                BorderThickness="0"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasMovieError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding MovieErrorMessage}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="#12FFFFFF"
                                BorderThickness="0"
                                CornerRadius="18"
                                Padding="22"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsMovieEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54"
                                        Height="54"
                                        CornerRadius="20"
                                        Background="#204EA2FF"
                                        BorderBrush="#3A69B1FF"
                                        BorderThickness="1"
                                        Margin="0,0,0,12">
                                    <Viewbox Width="25" Height="25">
                                        <Path Data="M6,3 L18,3 L18,21 L12,17.2 L6,21 Z"
                                              Fill="{DynamicResource Brush.AccentHover}"
                                              Stroke="{DynamicResource Brush.TextPrimary}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{Binding MovieEmptyStateTitle}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding MovieEmptyStateMessage}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox x:Name="MovieList"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleMovies}"
                             SelectedItem="{Binding SelectedMovie}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovieSkeletonVisible}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.38" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource OnDemandPosterItemStyle}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="104" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource OnDemandPosterFrameStyle}">
                                        <Image Source="{Binding PosterUri, IsAsync=True}"
                                               Style="{StaticResource OnDemandPosterImageStyle}"
                                               CacheMode="BitmapCache" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,8,2,2" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ContentControl Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource OnDemandCatalogSkeletonTemplate}"
                                    IsHitTestVisible="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMovieSkeletonVisible}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.28" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.36" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <Button Grid.Row="2"
                            Content="{Binding MovieLoadMoreText}"
                            Command="{Binding LoadMoreMoviesCommand}"
                            Style="{StaticResource OnDemandSecondaryButtonStyle}"
                            Width="300"
                            Height="38"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasMoreMovies, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Grid Grid.RowSpan="2"
                      Visibility="{Binding IsSeriesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid Height="36" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{loc:Loc Series}"
                                       Margin="0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PanelTitleTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeriesSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Grid.Column="0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource HeaderSearchFieldBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeriesSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Opacity" Value="1" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0"
                                                                             To="1"
                                                                             Duration="0:0:0.16" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="-8"
                                                                             To="0"
                                                                             Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                        <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                              Stroke="{DynamicResource Brush.AccentHover}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Viewbox>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SeriesSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource Brush.TextPrimary}"
                                             CaretBrush="{DynamicResource Brush.AccentHover}"
                                             FontSize="13"
                                             Margin="0"
                                             VerticalContentAlignment="Center"
                                             IsVisibleChanged="SearchTextBox_OnIsVisibleChanged" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SeriesResultSummary}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="12"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Command="{Binding ShowSeriesSearchCommand}"
                                        ToolTip="{loc:Loc SearchSeries}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeriesSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding CloseSeriesSearchCommand}"
                                        ToolTip="{loc:Loc CloseSearch}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeriesSearchVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="13" Height="13">
                                    <Path Data="M2,2 L12,12 M12,2 L2,12"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                        </Grid>

                        <Border Background="#0F1A2C"
                                BorderBrush="#233B5B"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasContinueWatchingSeries, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Height="36"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc ContinueWatching}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleSeriesContinueWatchingCommand}"
                                            Style="{StaticResource ContinueWatchingToggleButtonStyle}"
                                            Tag="{Binding IsSeriesContinueWatchingExpanded}">
                                        <Viewbox Width="15" Height="15">
                                            <Path Style="{StaticResource ContinueWatchingChevronPathStyle}" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              MaxHeight="132"
                                              Margin="0,10,0,0"
                                              Visibility="{Binding IsSeriesContinueWatchingExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding ContinueWatchingSeries}"
                                                  Margin="0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.PlayContinueWatchingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ContinueWatchingCardButtonStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="46"
                                                                Height="62"
                                                                Background="{DynamicResource Brush.SurfaceRaised}"
                                                                CornerRadius="9"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding PosterUri, IsAsync=True}"
                                                                   Style="{StaticResource ContinueWatchingPosterImageStyle}"
                                                                   CacheMode="BitmapCache" />
                                                        </Border>
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SubtitleText}"
                                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                                       FontSize="10"
                                                                       Margin="0,3,0,0"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="3"
                                                                         Margin="0,8,0,0"
                                                                         Foreground="{DynamicResource Brush.StreamAccent}"
                                                                         Background="#24FFFFFF"
                                                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Background="#16FFFFFF"
                                BorderThickness="0"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasSeriesError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding SeriesErrorMessage}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="#12FFFFFF"
                                BorderThickness="0"
                                CornerRadius="18"
                                Padding="22"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsSeriesEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54"
                                        Height="54"
                                        CornerRadius="20"
                                        Background="#204EA2FF"
                                        BorderBrush="#3A69B1FF"
                                        BorderThickness="1"
                                        Margin="0,0,0,12">
                                    <Viewbox Width="25" Height="25">
                                        <Path Data="M6,3 L18,3 L18,21 L12,17.2 L6,21 Z"
                                              Fill="{DynamicResource Brush.AccentHover}"
                                              Stroke="{DynamicResource Brush.TextPrimary}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{Binding SeriesEmptyStateTitle}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding SeriesEmptyStateMessage}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox x:Name="SeriesList"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleSeries}"
                             SelectedItem="{Binding SelectedSeries}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="1,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="SmoothList_OnPreviewMouseWheel">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeriesSkeletonVisible}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.38" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource OnDemandPosterItemStyle}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="104" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource OnDemandPosterFrameStyle}">
                                        <Image Source="{Binding PosterUri, IsAsync=True}"
                                               Style="{StaticResource OnDemandPosterImageStyle}"
                                               CacheMode="BitmapCache" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,8,2,2" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ContentControl Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource OnDemandCatalogSkeletonTemplate}"
                                    IsHitTestVisible="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeriesSkeletonVisible}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.28" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.36" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <Button Grid.Row="2"
                            Content="{Binding SeriesLoadMoreText}"
                            Command="{Binding LoadMoreSeriesCommand}"
                            Style="{StaticResource OnDemandSecondaryButtonStyle}"
                            Width="300"
                            Height="38"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasMoreSeries, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="PlaybackPanel" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
            <Grid x:Name="PlaybackLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Border Background="#10FFFFFF"
                            BorderThickness="0"
                            CornerRadius="16"
                            Padding="14,12"
                            Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                                            <TextBlock Text="{loc:Loc NowPlaying}"
                                       Foreground="{DynamicResource Brush.AccentHover}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CurrentChannelTitle}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PlaybackStatusText}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Height="322"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Border Background="{DynamicResource Brush.OnDemandSoftSurface}"
                                        BorderThickness="0"
                                        CornerRadius="18"
                                        ClipToBounds="True">
                                    <Grid Height="318">
                                        <Image Source="{Binding SelectedMovieDetails.BackdropUri, IsAsync=True}" Stretch="UniformToFill" Opacity="0.46" CacheMode="BitmapCache" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#D7070C16" Offset="0" />
                                                    <GradientStop Color="#A6070C16" Offset="0.48" />
                                                    <GradientStop Color="#F2070C16" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <Grid Margin="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="136"
                                                    Height="202"
                                                    Background="{DynamicResource Brush.OnDemandRaisedSurface}"
                                                    CornerRadius="14"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Top">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.24" />
                                                </Border.Effect>
                                                <Image Source="{Binding SelectedMovieDetails.PosterUri, IsAsync=True}" Stretch="UniformToFill" CacheMode="BitmapCache" />
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc FeatureFilm}"
                                                           Foreground="{DynamicResource Brush.StreamAccentHover}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,6" />
                                                 <TextBlock Text="{Binding SelectedMovieDetails.Title, TargetNullValue=Select a movie}"
                                                            FontSize="26"
                                                            FontWeight="Bold"
                                                            LineHeight="30"
                                                            TextWrapping="Wrap"
                                                            TextTrimming="CharacterEllipsis"
                                                            Height="62" />
                                                 <Border Background="#1CFFFFFF"
                                                         CornerRadius="12"
                                                         Padding="10,5"
                                                         Height="28"
                                                         HorizontalAlignment="Left"
                                                         Margin="0,8,0,10">
                                                     <TextBlock Text="{Binding SelectedMovieDetails.MetadataLine}"
                                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis" />
                                                 </Border>
                                                 <TextBlock Text="{Binding SelectedMovieDetails.DescriptionText, TargetNullValue=Choose a movie from the grid to see its details.}"
                                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                                            FontSize="13"
                                                            LineHeight="18"
                                                            TextWrapping="Wrap"
                                                            TextTrimming="CharacterEllipsis"
                                                            Height="56" />
                                                 <Grid Height="74" Margin="0,12,0,0">
                                                     <StackPanel Orientation="Horizontal"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center">
                                                     <Button
                                                             Content="{loc:Loc Play}"
                                                             Command="{Binding PlaySelectedMovieCommand}"
                                                             Style="{StaticResource OnDemandCompactPlayButtonStyle}" />
                                                     <Button
                                                             Content="{loc:Loc Resume}"
                                                             Command="{Binding ResumeSelectedMovieCommand}"
                                                             Style="{StaticResource OnDemandCompactResumeButtonStyle}"
                                                             Margin="8,0,0,0"
                                                             Visibility="{Binding HasSelectedMovieResumeProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                     <Button
                                                             Content="{Binding MovieWatchlistButtonText}"
                                                             ContentTemplate="{StaticResource FixedActionButtonContentTemplate}"
                                                             Command="{Binding ToggleMovieWatchlistCommand}"
                                                             Style="{StaticResource OnDemandCompactWatchlistButtonStyle}"
                                                             Margin="8,0,0,0" />
                                                     </StackPanel>
                                                 </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ContentControl HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource OnDemandFeaturedSkeletonTemplate}"
                                                IsHitTestVisible="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMovieFeaturedSkeletonVisible}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0"
                                                                                 To="1"
                                                                                 Duration="0:0:0.22" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0"
                                                                                 Duration="0:0:0.36" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Grid>

                            <TextBlock Text="{Binding MovieDetailsErrorMessage}"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasMovieDetailsError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Height="322"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsSeriesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Border Background="{DynamicResource Brush.OnDemandSoftSurface}"
                                        BorderThickness="0"
                                        CornerRadius="18"
                                        ClipToBounds="True">
                                    <Grid Height="318">
                                        <Image Source="{Binding SelectedSeriesDetails.BackdropUri, IsAsync=True}" Stretch="UniformToFill" Opacity="0.46" CacheMode="BitmapCache" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#D7070C16" Offset="0" />
                                                    <GradientStop Color="#A6070C16" Offset="0.48" />
                                                    <GradientStop Color="#F2070C16" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <Grid Margin="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="136"
                                                    Height="202"
                                                    Background="{DynamicResource Brush.OnDemandRaisedSurface}"
                                                    CornerRadius="14"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Top">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.24" />
                                                </Border.Effect>
                                                <Image Source="{Binding SelectedSeriesDetails.PosterUri, IsAsync=True}" Stretch="UniformToFill" CacheMode="BitmapCache" />
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc SeriesUpper}"
                                                           Foreground="{DynamicResource Brush.StreamAccentHover}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,6" />
                                                 <TextBlock Text="{Binding SelectedSeriesDetails.Title, TargetNullValue=Select a series}"
                                                            FontSize="26"
                                                            FontWeight="Bold"
                                                            LineHeight="30"
                                                            TextWrapping="Wrap"
                                                            TextTrimming="CharacterEllipsis"
                                                            Height="62" />
                                                 <Border Background="#1CFFFFFF"
                                                         CornerRadius="12"
                                                         Padding="10,5"
                                                         Height="28"
                                                         HorizontalAlignment="Left"
                                                         Margin="0,8,0,10">
                                                     <TextBlock Text="{Binding SelectedSeriesDetails.MetadataLine}"
                                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis" />
                                                 </Border>
                                                 <TextBlock Text="{Binding SelectedSeriesDetails.DescriptionText, TargetNullValue=Choose a series from the grid to see seasons and episodes.}"
                                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                                            FontSize="13"
                                                            LineHeight="18"
                                                            TextWrapping="Wrap"
                                                            TextTrimming="CharacterEllipsis"
                                                            Height="56" />
                                                 <Grid Height="74" Margin="0,12,0,0">
                                                     <StackPanel Orientation="Horizontal"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center">
                                                     <Button
                                                             Content="{loc:Loc Play}"
                                                             Command="{Binding PlaySelectedSeriesCommand}"
                                                             Style="{StaticResource OnDemandCompactPlayButtonStyle}" />
                                                     <Button
                                                             Content="{loc:Loc Resume}"
                                                             Command="{Binding ResumeSelectedSeriesCommand}"
                                                             Style="{StaticResource OnDemandCompactResumeButtonStyle}"
                                                             Margin="8,0,0,0"
                                                             Visibility="{Binding HasSelectedSeriesResumeProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                     <Button
                                                             Content="{Binding SeriesWatchlistButtonText}"
                                                             ContentTemplate="{StaticResource FixedActionButtonContentTemplate}"
                                                             Command="{Binding ToggleSeriesWatchlistCommand}"
                                                             Style="{StaticResource OnDemandCompactWatchlistButtonStyle}"
                                                             Margin="8,0,0,0" />
                                                     </StackPanel>
                                                 </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ContentControl HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource OnDemandFeaturedSkeletonTemplate}"
                                                IsHitTestVisible="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeriesFeaturedSkeletonVisible}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0"
                                                                                 To="1"
                                                                                 Duration="0:0:0.22" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0"
                                                                                 Duration="0:0:0.36" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Grid>

                            <TextBlock Text="{Binding SeriesDetailsErrorMessage}"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasSeriesDetailsError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Border Background="#16FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Padding="12"
                                    Height="44"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsSeriesDetailsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Loc NoEpisodesReturned}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding SelectedSeriesDetails.Seasons}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Margin="2,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Episodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#12FFFFFF"
                                                                BorderThickness="0"
                                                                CornerRadius="12"
                                                                Padding="12"
                                                                Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="13"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding MetadataLine}"
                                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                                               FontSize="11"
                                                                               Margin="0,2,0,0"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                 <Button Grid.Column="1"
                                                     Content="{loc:Loc Play}"
                                                                         Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         CommandParameter="{Binding}"
                                                                         Style="{StaticResource OnDemandSecondaryButtonStyle}"
                                                                         Width="76"
                                                                         MinWidth="76"
                                                                        Padding="12,6"
                                                                        Margin="10,0,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1"
                      x:Name="PlayerRowHost"
                      Background="Transparent"
                      SizeChanged="PlayerSurfaceHost_OnSizeChanged">
                    <Grid x:Name="PlayerSurfaceHost"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Background="Transparent">
                        <Border x:Name="PlayerSurface"
                                Background="#000000"
                                CornerRadius="0"
                                BorderBrush="#604EA2FF"
                                BorderThickness="1"
                                ClipToBounds="True"
                                MouseEnter="PlayerSurface_OnMouseActivity"
                                MouseMove="PlayerSurface_OnMouseActivity"
                                MouseLeave="PlayerSurface_OnMouseLeave"
                                MouseLeftButtonUp="PlayerSurface_OnMouseLeftButtonUp">
                            <Grid Background="#000000"
                                  ClipToBounds="True">
                                <vlc:VideoView x:Name="PlayerView"
                                               AutomationProperties.Name="Video player"
                                               Background="#000000"
                                               IsHitTestVisible="True">
                                    <vlc:VideoView.Style>
                                        <Style TargetType="{x:Type vlc:VideoView}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNativeVideoSurfaceVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </vlc:VideoView.Style>
                                </vlc:VideoView>
                                <Grid Background="#FF000000"
                                      IsHitTestVisible="False"
                                      Panel.ZIndex="20"
                                      Visibility="{Binding IsPlayerSurfaceOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="62"
                                          Height="62"
                                          RenderTransformOrigin="0.5,0.5"
                                          Visibility="{Binding IsPlayerSurfaceLoadingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Grid.RenderTransform>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlayerSurfaceLoadingVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="PlayerLoadingSpinnerStoryboard">
                                                                <Storyboard RepeatBehavior="Forever"
                                              Timeline.DesiredFrameRate="60">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0"
                                                                                     To="360"
                                                                                     Duration="0:0:0.72" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="PlayerLoadingSpinnerStoryboard" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Ellipse Stroke="#244EA2FF"
                                                 StrokeThickness="4" />
                                        <Path Stroke="{DynamicResource Brush.StreamAccentHover}"
                                              StrokeThickness="4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 31,5 A 26,26 0 1 1 12,49" />
                                        <Path Stroke="#FFFFFFFF"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Opacity="0.38"
                                              Data="M 31,5 A 26,26 0 0 1 53,22" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="28"
                                                MaxWidth="560"
                                                Visibility="{Binding IsPlayerSurfaceTextVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PlayerSurfaceOverlayTitle}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PlayerSurfaceOverlayMessage}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontSize="13"
                                                   LineHeight="19"
                                                   Margin="0,8,0,0"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="MiniVodControlsOverlay"
                                      Opacity="0"
                                      IsHitTestVisible="False"
                                      Visibility="{Binding IsOnDemandPlaybackControlVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border VerticalAlignment="Bottom"
                                            Margin="14"
                                            Padding="14,12"
                                            Background="#D4070C16"
                                            BorderBrush="#554EA2FF"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Slider Grid.Row="0"
                                                    Minimum="0"
                                                    Maximum="{Binding PlaybackDurationSeconds}"
                                                    Value="{Binding PlaybackPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding IsPlaybackSeekAvailable}"
                                                    Style="{StaticResource PremiumTimelineSliderStyle}"
                                                    PreviewMouseLeftButtonDown="VodTimelineSlider_OnPreviewMouseLeftButtonDown"
                                                    Margin="0,0,0,8" />

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Content="-10s"
                                                        Command="{Binding SeekBackwardCommand}"
                                                        Style="{StaticResource MiniPlayerControlButtonStyle}"
                                                        Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                <Button Content="{loc:Loc Play}"
                                                            Command="{Binding ResumeCommand}"
                                                            Style="{StaticResource MiniPlayerControlButtonStyle}"
                                                            Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="{loc:Loc Play}"
                                                            Command="{Binding ResumeCommand}"
                                                            Style="{StaticResource MiniPlayerControlButtonStyle}"
                                                            Visibility="{Binding IsSeriesSection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="{loc:Loc Pause}"
                                                            Command="{Binding PauseCommand}"
                                                            Style="{StaticResource MiniPlayerControlButtonStyle}" />
                                                    <Button Content="{Binding MuteButtonText}"
                                                            Command="{Binding ToggleMuteCommand}"
                                                            Style="{StaticResource MiniPlayerControlButtonStyle}"
                                                            Margin="0,0,10,0" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}">
                                                        <Run Text="{Binding PlaybackPositionText}" />
                                                        <Run Text=" / " />
                                                        <Run Text="{Binding PlaybackDurationText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="4"
                                                        Content="+10s"
                                                        Command="{Binding SeekForwardCommand}"
                                                        Style="{StaticResource MiniPlayerControlButtonStyle}"
                                                        Margin="8,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,10,0,0" MinHeight="56">
                    <Border Background="{DynamicResource Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Brush.InputBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Loc Play}" Style="{StaticResource PlayerControlButtonStyle}" Command="{Binding PlaySelectedChannelCommand}" />
                                <Button Content="{loc:Loc Stop}" Style="{StaticResource PlayerControlButtonStyle}" Command="{Binding StopCommand}" />
                            <Button Content="{Binding MuteButtonText}"
                                    Style="{StaticResource PlayerControlButtonStyle}"
                                    Command="{Binding ToggleMuteCommand}" />
                                <Button Content="{loc:Loc Fullscreen}"
                                        Style="{StaticResource PlayerControlButtonStyle}"
                                        Click="FullscreenToggleButton_OnClick"
                                        Margin="0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Brush.InputBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Visibility="{Binding IsOnDemandSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Slider Minimum="0"
                                    Maximum="{Binding PlaybackDurationSeconds}"
                                    Value="{Binding PlaybackPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsPlaybackSeekAvailable}"
                                    Visibility="{Binding IsOnDemandPlaybackControlVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource PremiumTimelineSliderStyle}"
                                    PreviewMouseLeftButtonDown="VodTimelineSlider_OnPreviewMouseLeftButtonDown"
                                    Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Loc Play}"
                                        Command="{Binding PlaySelectedMovieCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OnDemandPlayerControlButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMoviesSection}" Value="True" />
                                                        <Condition Binding="{Binding IsOnDemandPlaybackActive}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{loc:Loc Play}"
                                        Command="{Binding PlaySelectedSeriesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OnDemandPlayerControlButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSeriesSection}" Value="True" />
                                                        <Condition Binding="{Binding IsOnDemandPlaybackActive}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{loc:Loc Play}"
                                        Style="{StaticResource OnDemandPlayerControlButtonStyle}"
                                        Command="{Binding ResumeCommand}"
                                        Visibility="{Binding IsOnDemandPlaybackControlVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{loc:Loc Pause}"
                                        Style="{StaticResource OnDemandPlayerControlButtonStyle}"
                                        Command="{Binding PauseCommand}"
                                        Visibility="{Binding IsOnDemandPlaybackControlVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{loc:Loc Stop}"
                                        Style="{StaticResource OnDemandPlayerControlButtonStyle}"
                                        Command="{Binding StopCommand}" />
                                <Button Content="{Binding MuteButtonText}"
                                        Style="{StaticResource OnDemandPlayerControlButtonStyle}"
                                        Command="{Binding ToggleMuteCommand}" />
                                <Button Content="{loc:Loc Fullscreen}"
                                        Style="{StaticResource OnDemandPlayerControlButtonStyle}"
                                        Click="FullscreenToggleButton_OnClick"
                                        Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Brush.InputBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsLiveTvSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#13253D"
                                    BorderBrush="#365578"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#1D3D63"
                                            BorderBrush="#5E94CE"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,7"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedChannel.CurrentProgramTimeRange, TargetNullValue=NOW}"
                                                   Foreground="#FFFFFFFF"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc LiveEpg}"
                                                   Foreground="{DynamicResource Brush.AccentHover}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedChannel.CurrentProgramTitle, TargetNullValue=No real EPG data available from provider.}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,3"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedChannel.CurrentProgramDescription, TargetNullValue=Provider did not include programme details.}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="50" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#122138"
                                    BorderBrush="#324F71"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#172F50"
                                            BorderBrush="#4F7EAF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,7"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SelectedChannel.NextProgramTimeRange, TargetNullValue=NEXT}"
                                                   Foreground="#FFE8F1FF"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc UpNext}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.AccentHover}" />
                                        <TextBlock Text="{Binding SelectedChannel.NextProgramTitle, TargetNullValue=No upcoming real EPG data available from provider.}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,3"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedChannel.NextProgramDescription, TargetNullValue=Provider did not include upcoming programme details.}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="50" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="FullscreenOverlay"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="#FF000000"
              Visibility="Collapsed"
              MouseMove="FullscreenOverlay_OnMouseMove"
              Panel.ZIndex="200">
            <Grid x:Name="FullscreenHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="#FF000000" />

        </Grid>

    </Grid>
</Window>
