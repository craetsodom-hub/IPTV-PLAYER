                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="SkeletonShimmerTransform" X="-1.4" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#14243A" Offset="0" />
                                    <GradientStop Color="#14243A" Offset="0.36" />
                                    <GradientStop Color="#1A3555" Offset="0.46" />
                                    <GradientStop Color="#38658F" Offset="0.52" />
                                    <GradientStop Color="#1A3555" Offset="0.58" />
                                    <GradientStop Color="#14243A" Offset="0.68" />
                                    <GradientStop Color="#14243A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SkeletonShimmerTransform"
                                                             Storyboard.TargetProperty="X"
                                                             From="-1.4"
                                                             To="1.4"
                                                              Duration="0:0:1.85" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
