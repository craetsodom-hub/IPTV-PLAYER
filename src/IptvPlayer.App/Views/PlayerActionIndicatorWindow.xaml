<Window x:Class="IptvPlayer.App.Views.PlayerActionIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IptvPlayer.App.Controls"
        xmlns:loc="clr-namespace:IptvPlayer.App.Localization"
        Title="{loc:Loc PlayerAction}"
        Width="92"
        Height="92"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <controls:PlayerActionIndicator />
</Window>
